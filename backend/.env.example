APP_NAME=ProgressAI
ENVIRONMENT=development
API_PREFIX=/api
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
ACCESS_TOKEN_MINUTES=60
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=progressai
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000
ENABLE_SCHEDULER=false
REMINDER_INTERVAL_MINUTES=15
REMINDER_HOURS_BEFORE_DEADLINE=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
MODEL_DIR=ml/artifacts
